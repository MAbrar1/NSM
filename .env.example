# ═══════════════════════════════════════════════════════════════
# ELITE POS — Environment Variables
# Copy this to .env.local and fill in the values.
# ═══════════════════════════════════════════════════════════════

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/elite_pos?schema=public"
#
# Production migration workflow (see docs/DATABASE-MIGRATIONS.md):
#   npm run db:migrate          # create + apply a migration locally
#   npm run db:migrate:deploy   # apply pending migrations (CI/prod)
#   npm run db:migrate:status   # pre-deploy schema check

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ElitePOS"

# Product image uploads — two storage drivers (served by /api/files/[name])
#
# local (default): filesystem under UPLOAD_DIR; relative paths resolve from
#   the project root. Defaults to ./uploads.
#   UPLOAD_DIR="./uploads"
#
# s3: any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Backblaze B2,
#   DigitalOcean Spaces…). The files route 302-redirects to a short-lived
#   presigned URL; the DB keeps storing /api/files/<name> URLs either way.
#   STORAGE_DRIVER="s3"
#   S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
#   S3_REGION="us-east-1"
#   S3_BUCKET="my-store-images"
#   S3_ACCESS_KEY_ID="..."
#   S3_SECRET_ACCESS_KEY="..."
#   S3_SESSION_TOKEN=""   # optional, temporary credentials only

# Authentication
# AUTH_URL / NEXTAUTH_URL is the app's canonical origin and should match the
# port the server actually listens on. In dev the port can drift (Next picks
# the next free port when 3000 is taken); Auth.js is configured with
# `trustHost`, so sign-in callbacks and redirects follow the browser's Host
# header even if this value is stale.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-here-change-in-production"
NEXTAUTH_SECRET="your-secret-here-change-in-production"

# Store Settings
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_DEFAULT_TAX_RATE="0"

# Seed API (development only)
# POST /api/seed re-runs the database seed and WIPES existing data. It is
# disabled in production and fails closed unless this key is set and sent
# as the `x-seed-key` header:
#   curl -X POST http://localhost:3000/api/seed -H "x-seed-key: $SEED_API_KEY"
# The CLI seeder `npm run db:seed` does not use this endpoint and needs no key.
# SEED_API_KEY="change-me"

# Cron / scheduled jobs (low-stock notifications + reservation cleanup)
# Set a shared secret, then POST with `Authorization: Bearer <CRON_SECRET>`
# (or `x-cron-secret` header) from any cron service (Vercel Cron,
# cron-job.org, Windows Task Scheduler…) to:
#   /api/notifications/low-stock/run     — scan + send low-stock alerts
#   /api/inventory/reserve/cleanup       — release stale stock reservations
#   /api/maintenance/run                 — prune login attempts + orphan images
# Without it both endpoints still work for signed-in admins, and the
# in-process schedulers (production `next start`) run both jobs anyway.
# CRON_SECRET="change-me"
