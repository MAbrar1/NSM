# Pre-images written by scripts/codemod-*.mjs before they rewrite a file
.codemod-backup/

# Stray Chrome debug profiles — must NOT live in the watched tree: Chrome's
# constant writes make `next dev` recompile in a loop and truncate .next,
# which 500s every API route. See next.config.ts watchOptions.
.dbg-profile*/
.dbg-profile-file*

# Uploaded product images (served by /api/files)
uploads/
