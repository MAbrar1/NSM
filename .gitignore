# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
# Isolated production build dir (NEXT_DIST_DIR, see next.config.ts)
.next-prod/
out/

# Production build
build/
dist/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
*.tsbuildinfo

# Prisma
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal

# Misc
*.local
.vercel/

# QA artifacts (browser audit screenshots + dev server log)
.audit-shots/
.audit-baseline/
.audit-*.log
.audit-*.out
.audit-*.txt
.audit-dev-server.log
.dev-server.log
/*.log
.audit-pos-log.txt
.audit-chrome-profile*
.audit-neu-pages-profile*/
.verify-ui-profile*/
.probe-prof*/
css-badlines.txt

# Pre-images written by scripts/codemod-*.mjs before they rewrite a file
.codemod-backup/

# Stray Chrome debug profiles — must NOT live in the watched tree: Chrome's
# constant writes make `next dev` recompile in a loop and truncate .next,
# which 500s every API route. See next.config.ts watchOptions.
.dbg-profile*/
.dbg-profile-file*

# History-rewrite backup bundles (pre-push safety net; several hundred MB
# of build-cache blobs once made a push bounce — never commit one).
*.bundle

# Local lint/report artifacts from ad-hoc analysis runs
lint-report.json
lint-errors.json

# Throwaway SQLite databases created at the repo root (CI simulation,
# ad-hoc prisma db push against DATABASE_URL=file:./x.db)
/*.db
/*.db-journal

# Agent/tooling state
.freebuff/

# Uploaded product images (served by /api/files) — keep the dir, ignore contents
uploads/*
!uploads/.gitkeep

# Print/export samples — fully regenerated by `npm run samples`
samples/
